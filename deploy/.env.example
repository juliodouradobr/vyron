# Copie para .env (na pasta deploy/) e preencha. NUNCA envie o .env para o Git.

# Domínio que aponta para este servidor (registro DNS tipo A com o IP público dele).
DOMAIN=vyron.seudominio.com.br

# E-mail para o Let's Encrypt avisar sobre o certificado HTTPS.
ACME_EMAIL=voce@seudominio.com.br

# Senhas fortes e aleatórias. Gere cada uma com:  openssl rand -base64 32
POSTGRES_PASSWORD=
TURN_SECRET=
