# Copie para apps/server/.env e ajuste. Nunca versione o .env real.

# Vazio = PGlite embutido em apps/server/.data (somente desenvolvimento).
# Produção: postgres://usuario:senha@host:5432/nexo
DATABASE_URL=

HOST=127.0.0.1
PORT=4100

# Origens autorizadas a chamar a API (separadas por vírgula).
# tauri://localhost e http://tauri.localhost são as origens do app empacotado.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost,http://tauri.localhost

# Atrás de proxy reverso com TLS, defina true para respeitar X-Forwarded-For.
TRUST_PROXY=false

LOG_LEVEL=info

# Voz (Etapa 3). Vazio = só candidatos locais: funciona na mesma rede, não atravessa todos os NATs.
# STUN_URLS=stun:stun.seu-dominio:3478
# TURN (coturn com: use-auth-secret / static-auth-secret=<o mesmo segredo>). Habilita "Ocultar meu IP".
# TURN_URLS=turn:turn.seu-dominio:3478?transport=udp,turns:turn.seu-dominio:443?transport=tcp
# TURN_SECRET=

# Onde ficam anexos, avatares e banners (relativo a apps/server). Em produção, use um disco persistente
# com backup — ou troque o armazenamento por um de objetos (interface FileStore em src/files/store.ts).
# FILES_DIR=.data/files

# Contas de teste que existem SÓ no banco local de desenvolvimento (apps/server/.data, fora do Git).
# Não existem no servidor de produção — lá cada pessoa cria a própria conta:
#   usuário: teste_jogador   senha: senha-de-teste-nexo-1
#   usuário: teste_amigo     senha: senha-de-teste-nexo-2
# Apague apps/server/.data/ para recomeçar com o banco vazio.
